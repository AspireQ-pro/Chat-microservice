VITE_API_URL=http://3.110.56.109:5000
VITE_SOCKET_URL=http://3.110.56.109:5000
# VITE_ALLOW_DEV_LOGIN should only be true when running fully locally (no real server).
# With a real VITE_API_URL set, leave this false/unset or the app will use a
# "dev-mock-token" when no ?token= is in the URL, which skips socket setup
# entirely and breaks real-time messaging.
VITE_ALLOW_DEV_LOGIN=false

