# Copy to .env and fill every value before building or starting production containers.
# Use URL-safe generated secrets, not the placeholders below.
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_PASSWORD
CHAT_DATABASE_URL=postgresql://postgres:REPLACE_WITH_URL_SAFE_RANDOM_PASSWORD@chat-db:5432/chat_service
CHAT_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
MESSAGE_ENC_KEY=REPLACE_WITH_A_SEPARATE_STABLE_RANDOM_SECRET
PROJECT_REGISTRATION_SECRET=REPLACE_WITH_A_SEPARATE_ADMIN_SECRET
CHAT_FRONTEND_URL=https://chat.your-domain.example
CHAT_BACKEND_URL=https://chat-api.your-domain.example
CORS_ORIGIN=https://chat.your-domain.example,https://society.your-domain.example
SOCIETY_FRONTEND_ORIGIN=https://society.your-domain.example
