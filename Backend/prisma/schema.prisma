generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id        String   @id @default(uuid())
  name      String
  apiKey    String   @unique
  plan            String   @default("custom")
  allowGroupChat  Boolean  @default(false)
  allowDirectChat Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt DateTime @default(now())

  users     ChatUser[]
  rooms     ChatRoom[]
}

model ChatUser {
  id             String   @id @default(uuid())
  projectId      String
  externalUserId String
  name           String
  email          String?
  role           String?
  avatarUrl      String?
  avatarStorageKey String?
  lastSeenAt     DateTime?
  createdAt      DateTime @default(now())

  project        Project           @relation(fields: [projectId], references: [id])
  rooms          ChatRoomMember[]
  messages       Message[]
  deletedMessages MessageDeletion[]

  @@unique([projectId, externalUserId])
  @@index([projectId, name])
}

model ChatRoom {
  id                String   @id @default(uuid())
  projectId         String
  name              String?
  isGroup           Boolean  @default(false)
  directStatus      String   @default("accepted")
  requestedById     String?
  lastMessageAt     DateTime?
  lastMessagePreview String?
  avatarUrl         String?
  avatarStorageKey  String?
  description       String?
  createdAt         DateTime @default(now())

  project   Project           @relation(fields: [projectId], references: [id])
  members   ChatRoomMember[]
  messages  Message[]
}

model ChatRoomMember {
  roomId     String
  userId     String
  joinedAt   DateTime @default(now())
  lastReadAt DateTime?

  room     ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     ChatUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
}

model Message {
  id          String   @id @default(uuid())
  roomId      String
  senderId    String
  content     String?
  messageType String   @default("text")
  fileUrl     String?
  fileType    String?
  fileStorageKey String?
  isRead      Boolean  @default(false)
  readAt      DateTime?
  deliveredAt DateTime?
  editedAt    DateTime?
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())

  room       ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender     ChatUser @relation(fields: [senderId], references: [id])
  deletions  MessageDeletion[]

  @@index([roomId, createdAt])
}

model MessageDeletion {
  messageId  String
  userId     String
  deletedAt  DateTime @default(now())

  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user       ChatUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
}
