# Local development only. Use unique stable secrets and the correct database target.
DATABASE_URL=postgresql://postgres:URL_ENCODED_PASSWORD@localhost:5433/chat_service
CHAT_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
MESSAGE_ENC_KEY=REPLACE_WITH_A_SEPARATE_STABLE_RANDOM_SECRET
PROJECT_REGISTRATION_SECRET=REPLACE_WITH_A_SEPARATE_ADMIN_SECRET
BACKEND_URL=http://localhost:5000
CHAT_FRONTEND_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001,http://localhost:5173
PORT=5000
AWS_REGION=ap-south-1
S3_BUCKET=your-private-chat-media-bucket
# AWS_S3_BUCKET is accepted as an alternative name.
# Prefer the backend's IAM role in production; use access keys only for local development.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_SERVER_SIDE_ENCRYPTION=AES256
